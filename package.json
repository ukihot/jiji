{
	"name": "jiji",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"fmt": "prettier --write \"src/**/*.{js,ts,svelte,css}\"",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:apply": "bun run scripts/apply-migrations.ts",
		"db:push:d1": "drizzle-kit push --config drizzle.config.d1.ts",
		"db:generate:d1": "drizzle-kit generate --config drizzle.config.d1.ts",
		"db:seed": "bun run scripts/seed.ts"
	},
	"dependencies": {
		"@lucide/svelte": "^1.28.0",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.2",
		"layerchart": "^2.2.0",
		"rough-viz": "^2.0.5"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.23.1",
		"@libsql/client": "^0.17.4",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.10",
		"bun-types": "^1.3.14",
		"drizzle-kit": "^0.31.10",
		"playwright": "^1.62.1",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "0.6.14",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.0",
		"vite": "^8.2.0",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	}
}
